    <!-- JavaScript App Logic -->
    <script>
        let transactions = JSON.parse(localStorage.getItem('myfinance_tx')) || [];
        let goals = JSON.parse(localStorage.getItem('myfinance_goals')) || [];
        let settings = JSON.parse(localStorage.getItem('myfinance_settings')) || {
            accountName: 'Utama',
            childName: 'Deva',
            expenseCategories: ['Bayar Listrik', 'Belanja Bulanan', 'Makan', 'Jajan', 'Tabungan Pribadi', 'Tabungan Anak', 'Liburan', 'Goals'],
            wallets: [
                { name: 'Kebutuhan Sehari-hari', pct: 40 }, { name: 'Makan', pct: 20 }, { name: 'Jajan', pct: 10 },
                { name: 'Tabungan Pribadi', pct: 10 }, { name: 'Tabungan Anak', pct: 5 }, { name: 'Liburan', pct: 5 }, { name: 'Goals', pct: 10 }
            ]
        };

        const getDompetList = () => settings.wallets.map(w => w.name);

        let currentFilterYear = new Date().getFullYear().toString();
        let currentTxFilter = 'semua';

        const saveData = () => {
            localStorage.setItem('myfinance_tx', JSON.stringify(transactions));
            localStorage.setItem('myfinance_goals', JSON.stringify(goals));
            localStorage.setItem('myfinance_settings', JSON.stringify(settings));
            if(window.saveUserDataToCloud) window.saveUserDataToCloud();
        };

        // UI Navigation
        const navBtns = document.querySelectorAll('.nav-btn');
        const views = document.querySelectorAll('.view-section');
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebar-overlay');
        
        const toggleSidebar = (show) => {
            if (show) { sidebar.classList.remove('-translate-x-full'); sidebarOverlay.classList.remove('hidden'); }
            else { sidebar.classList.add('-translate-x-full'); sidebarOverlay.classList.add('hidden'); }
        };
        document.getElementById('open-sidebar').addEventListener('click', () => toggleSidebar(true));
        document.getElementById('close-sidebar').addEventListener('click', () => toggleSidebar(false));
        sidebarOverlay.addEventListener('click', () => toggleSidebar(false));

        window.switchView = (targetId) => {
            views.forEach(v => v.classList.remove('active'));
            document.getElementById(targetId).classList.add('active');
            navBtns.forEach(btn => {
                if(btn.dataset.target === targetId) {
                    btn.classList.replace('text-slate-600', 'text-indigo-700'); btn.classList.replace('hover:bg-slate-50', 'bg-indigo-50');
                } else {
                    btn.classList.replace('text-indigo-700', 'text-slate-600'); btn.classList.replace('bg-indigo-50', 'hover:bg-slate-50');
                }
            });
            if(window.innerWidth < 1024) toggleSidebar(false);
        };
        navBtns.forEach(btn => btn.addEventListener('click', () => switchView(btn.dataset.target)));

        // Modal Component
        const modal = document.getElementById('modal');
        const modalContent = document.getElementById('modal-content');
        let modalConfirmAction = null;

        const showModal = (title, message, isConfirm = false, onConfirm = null) => {
            document.getElementById('modal-title').textContent = title; document.getElementById('modal-message').textContent = message;
            const mConfirm = document.getElementById('modal-confirm'), mCancel = document.getElementById('modal-cancel');
            if (isConfirm) {
                mCancel.classList.remove('hidden');
                mConfirm.textContent = 'Ya, Hapus';
                mConfirm.className = 'px-5 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl font-medium transition-colors shadow-sm text-sm';
            } else {
                mCancel.classList.add('hidden');
                mConfirm.textContent = 'Tutup';
                mConfirm.className = 'px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-medium transition-colors shadow-sm text-sm';
            }
            modalConfirmAction = onConfirm;
            modal.classList.remove('hidden'); modal.classList.add('flex');
            setTimeout(() => { modal.classList.remove('opacity-0'); modalContent.classList.remove('scale-95'); }, 10);
        };
        const hideModal = () => {
            modal.classList.add('opacity-0'); modalContent.classList.add('scale-95');
            setTimeout(() => { modal.classList.add('hidden'); modal.classList.remove('flex'); }, 300);
        };
        document.getElementById('modal-cancel').addEventListener('click', hideModal);
        document.getElementById('modal-confirm').addEventListener('click', () => { if (modalConfirmAction) modalConfirmAction(); hideModal(); });

        // Utils Format Rupiah
        const formatRupiah = (num) => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(num);
        const formatDate = (dateStr) => new Date(dateStr).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
        const formatInputWithDot = (el) => {
            let val = el.value.replace(/[^,\d]/g, '').toString();
            let split = val.split(','), sisa = split[0].length % 3,
                rupiah = split[0].substr(0, sisa), ribuan = split[0].substr(sisa).match(/\d{3}/gi);
            if(ribuan){ let separator = sisa ? '.' : ''; rupiah += separator + ribuan.join('.'); }
            el.value = split[1] != undefined ? rupiah + ',' + split[1] : rupiah;
        };
        const getNumberFromInput = (val) => Number(val.replace(/\./g, '')) || 0;

        // --- KONFIGURASI SISTEM ---
        const renderWalletSettings = () => {
            const container = document.getElementById('set-wallets-container'); container.innerHTML = '';
            settings.wallets.forEach((w) => {
                container.innerHTML += `
                    <div class="flex items-center gap-2 mb-2 wallet-row bg-slate-50 p-2 rounded-lg border border-slate-100">
                        <input type="text" class="w-1/2 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:ring-2 focus:ring-indigo-500" value="${w.name}" placeholder="Nama Dompet" required>
                        <div class="w-1/3 relative">
                            <input type="number" class="w-full rounded-lg border border-slate-300 px-3 py-2 pr-8 text-sm focus:ring-2 focus:ring-indigo-500 pct-input" value="${w.pct}" min="0" max="100" required oninput="calculateWalletTotal()">
                            <span class="absolute right-3 top-2 text-sm text-slate-400">%</span>
                        </div>
                        <button type="button" onclick="removeWalletConfigRow(this)" class="p-2 text-rose-500 hover:bg-rose-100 rounded-lg transition-colors"><i class="ph ph-trash"></i></button>
                    </div>`;
            });
            calculateWalletTotal();
        };
        window.addWalletConfigRow = () => { settings.wallets.push({ name: '', pct: 0 }); renderWalletSettings(); };
        window.removeWalletConfigRow = (btn) => {
            const row = btn.closest('.wallet-row'); const idx = Array.from(row.parentNode.children).indexOf(row);
            settings.wallets.splice(idx, 1); renderWalletSettings();
        };
        window.calculateWalletTotal = () => {
            let total = 0; document.querySelectorAll('.pct-input').forEach(inp => total += (Number(inp.value) || 0));
            const totEl = document.getElementById('set-wallets-total');
            totEl.textContent = `Total: ${total}%`;
            totEl.className = total === 100 ? 'text-xs font-bold px-3 py-1.5 rounded-lg bg-emerald-100 text-emerald-700' : 'text-xs font-bold px-3 py-1.5 rounded-lg bg-rose-100 text-rose-700';
        };
        document.getElementById('form-settings').addEventListener('submit', (e) => {
            e.preventDefault();
            let totalPct = 0; const newWallets = [];
            document.querySelectorAll('.wallet-row').forEach(r => {
                const name = r.querySelector('input[type="text"]').value.trim(), pct = Number(r.querySelector('.pct-input').value) || 0;
                if(name) { newWallets.push({ name, pct }); totalPct += pct; }
            });
            if(totalPct !== 100) return showModal('Gagal', `Total persentase dompet harus tepat 100%. Saat ini: ${totalPct}%`);

            settings.accountName = document.getElementById('set-account-name').value;
            settings.childName = document.getElementById('set-child-name').value;
            const cats = document.getElementById('set-categories').value.split(',').map(s => s.trim()).filter(s => s);
            if(cats.length > 0) settings.expenseCategories = cats;
            settings.wallets = newWallets;
            saveData(); updateUI(); showModal('Sukses', 'Konfigurasi tersimpan.');
        });

        // --- LOGIKA ALOKASI DOMPET & TRANSAKSI ---
        window.toggleFormAdd = () => {
            const type = document.querySelector('input[name="type"]:checked').value;
            const inContainer = document.getElementById('add-category-in-container');
            const outWalletContainer = document.getElementById('add-wallet-out-container');
            const outCategoryContainer = document.getElementById('add-category-out-container');
            if (type === 'masuk') {
                inContainer.style.display = 'block'; outWalletContainer.style.display = 'none'; outCategoryContainer.style.display = 'none';
            } else {
                inContainer.style.display = 'none'; outWalletContainer.style.display = 'block'; outCategoryContainer.style.display = 'block';
            }
        };

        window.calculateAllocations = () => {
            const btnSubmit = document.getElementById('btn-submit-alloc');
            const allocSisa = document.getElementById('alloc-sisa'), allocError = document.getElementById('alloc-error');
            const totalAmount = getNumberFromInput(document.getElementById('alloc-amount-total').value);
            if(totalAmount === 0) { btnSubmit.disabled = true; return; }
            
            let totalAllocated = 0;
            document.querySelectorAll('.alloc-input').forEach(input => totalAllocated += getNumberFromInput(input.value));
            const diff = totalAmount - totalAllocated;
            
            if (diff === 0 && totalAmount > 0) {
                allocSisa.className = 'text-xs font-bold text-emerald-700 bg-emerald-100 px-3 py-1.5 rounded-full shadow-sm';
                allocSisa.textContent = `Sisa: Pas (Rp 0)`; btnSubmit.disabled = false; allocError.classList.add('hidden');
            } else {
                allocSisa.className = 'text-xs font-bold text-rose-600 bg-rose-100 px-3 py-1.5 rounded-full shadow-sm';
                allocSisa.textContent = `Sisa: ${formatRupiah(diff)}`; btnSubmit.disabled = true;
                if(totalAmount > 0) allocError.classList.remove('hidden');
            }
        };

        window.selectIncomeForAllocation = (id, amount, desc, date) => {
            document.getElementById('alloc-tx-id').value = id;
            document.getElementById('alloc-amount-total').value = formatRupiah(amount).replace('Rp', '').trim();
            document.getElementById('alloc-selected-desc').innerHTML = `Membagikan Dana: <b class="text-indigo-900">${desc}</b> (Total: ${formatRupiah(amount)})`;
            
            // Auto calculate based on configured percentage
            settings.wallets.forEach(w => {
                const inp = document.querySelector(`.alloc-input[data-wallet="${w.name}"]`);
                if(inp) {
                    const val = Math.floor(amount * (w.pct / 100));
                    inp.value = formatRupiah(val).replace('Rp', '').replace(/,00$/, '').trim();
                }
            });
            calculateAllocations();
            document.getElementById('form-allocation').scrollIntoView({ behavior: 'smooth', block: 'center' });
        };

        window.clearAllAllocations = () => {
            document.querySelectorAll('.alloc-input').forEach(inp => {
                inp.value = '';
            });
            calculateAllocations();
        };

        function renderDompet() {
            let danaBelumDialokasikan = 0;
            let unallocatedListHtml = '';
            let dompetState = {};
            
            getDompetList().forEach(d => dompetState[d] = 0);
            
            transactions.forEach(tx => {
                const amount = Number(tx.amount);
                if (tx.type === 'masuk') {
                    if (!tx.allocations) {
                        danaBelumDialokasikan += amount;
                        unallocatedListHtml += `
                            <button onclick="selectIncomeForAllocation('${tx.id}', ${amount}, '${tx.description}', '${tx.date}')" 
                                type="button" class="w-full text-left bg-indigo-700/80 hover:bg-indigo-500 rounded-xl p-3 flex justify-between items-center border border-indigo-400/40 transition-all shadow-sm">
                                <div>
                                    <p class="text-sm font-bold text-white line-clamp-1">${tx.description}</p>
                                    <p class="text-xs text-indigo-200 mt-0.5"><span class="font-bold tracking-wider">${tx.category || 'Pemasukan'}</span> &bull; ${formatDate(tx.date)}</p>
                                </div>
                                <div class="font-bold text-white bg-indigo-900/60 px-3 py-1.5 rounded-lg shrink-0">${formatRupiah(amount)}</div>
                            </button>`;
                    } else {
                        for (let w in tx.allocations) {
                            if(dompetState[w] !== undefined) dompetState[w] += Number(tx.allocations[w]);
                        }
                    }
                } else if (tx.type === 'keluar' || tx.type === 'bayar_hutang') {
                    if (tx.wallet && dompetState[tx.wallet] !== undefined) dompetState[tx.wallet] -= amount;
                } else if (tx.type === 'catat_hutang') {
                    if (tx.wallet && dompetState[tx.wallet] !== undefined) dompetState[tx.wallet] += amount; 
                }
            });

            // Update UI Menu Alokasi Dompet
            const dompetUnallocatedEl = document.getElementById('dash-dompet-unallocated');
            if(dompetUnallocatedEl) {
                dompetUnallocatedEl.textContent = formatRupiah(danaBelumDialokasikan);
                const unallocContainer = document.getElementById('unallocated-list');
                if (unallocatedListHtml) {
                    unallocContainer.innerHTML = unallocatedListHtml;
                } else {
                    unallocContainer.innerHTML = `<div class="text-center py-5 bg-indigo-700/30 rounded-xl border border-indigo-500/30"><i class="ph ph-check-circle text-3xl text-indigo-300 mb-2"></i><p class="text-sm text-indigo-100 font-medium">Luar Biasa!</p><p class="text-xs text-indigo-200">Semua uang masuk telah selesai dibagikan.</p></div>`;
                }

                const allocWrapper = document.getElementById('alloc-inputs-wrapper');
                allocWrapper.innerHTML = '';
                settings.wallets.forEach(w => {
                    allocWrapper.innerHTML += `
                    <div class="flex flex-col gap-1 bg-white p-3 rounded-xl border border-slate-200">
                        <label class="text-xs font-bold text-slate-700">${w.name} <span class="text-indigo-500 font-medium bg-indigo-50 px-1.5 rounded">(${w.pct}%)</span></label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400 text-sm font-medium">Rp</span>
                            <input type="text" data-wallet="${w.name}" class="alloc-input w-full pl-9 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-bold text-slate-900 focus:border-indigo-500 focus:bg-white transition-colors" placeholder="0" oninput="formatInputWithDot(this); calculateAllocations()">
                        </div>
                    </div>`;
                });
            }

            // Update Saldo Tiap Dompet (di menu Alokasi Dompet & Dashboard utama)
            const dompetGrids = [document.getElementById('dash-dompet-grid'), document.getElementById('dash-main-dompet-grid')];
            dompetGrids.forEach(grid => {
                if(grid) {
                    grid.innerHTML = ''; 
                    const colors = ['blue', 'orange', 'yellow', 'emerald', 'teal', 'sky', 'purple', 'rose'];
                    settings.wallets.forEach((w, idx) => {
                        const col = colors[idx % colors.length];
                        grid.innerHTML += `
                        <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm border-l-4 border-l-${col}-500">
                            <span class="text-xs font-bold text-slate-500 block mb-1 uppercase tracking-wider">${w.name}</span>
                            <div class="text-lg font-bold text-slate-900">${formatRupiah(dompetState[w.name])}</div>
                        </div>`;
                    });
                }
            });
            return { dompetState, danaBelumDialokasikan };
        }

        function renderDashboard() {
            document.getElementById('dash-account-title').textContent = `- ${settings.accountName}`;
            let monthIn = 0, monthOut = 0, monthCategoryExpense = {}, totalHutang = 0;
            const now = new Date(), currMonth = now.getMonth(), currYear = now.getFullYear();
            
            const { dompetState, danaBelumDialokasikan } = renderDompet();

            transactions.forEach(tx => {
                const amount = Number(tx.amount), txDate = new Date(tx.date), isCurrentMonth = txDate.getMonth() === currMonth && txDate.getFullYear() === currYear;
                if (tx.type === 'masuk') { if (isCurrentMonth) monthIn += amount; }
                else if (tx.type === 'keluar') {
                    if (isCurrentMonth) { monthOut += amount; const cat = tx.category || 'Lainnya'; monthCategoryExpense[cat] = (monthCategoryExpense[cat] || 0) + amount; }
                } else if (tx.type === 'catat_hutang') totalHutang += amount;
                else if (tx.type === 'bayar_hutang') totalHutang -= amount;
            });

            let saldoTotal = danaBelumDialokasikan;
            for(let w in dompetState) saldoTotal += dompetState[w];
            document.getElementById('dash-saldo').textContent = formatRupiah(saldoTotal);
            document.getElementById('dash-month-in').textContent = formatRupiah(monthIn);
            document.getElementById('dash-month-out').textContent = formatRupiah(monthOut);
            document.getElementById('dash-hutang').textContent = formatRupiah(totalHutang);

            const budgetContainer = document.getElementById('budget-progress-container'); budgetContainer.innerHTML = '';
            if (Object.keys(monthCategoryExpense).length === 0) {
                budgetContainer.innerHTML = '<p class="text-sm text-slate-500 py-2 text-center mt-4">Belum ada pengeluaran kategori bulan ini.</p>';
            } else {
                const sortedCats = Object.keys(monthCategoryExpense).sort((a, b) => monthCategoryExpense[b] - monthCategoryExpense[a]);
                const colors = ['bg-rose-500', 'bg-orange-500', 'bg-amber-500', 'bg-blue-500', 'bg-purple-500'];
                sortedCats.forEach((cat, idx) => {
                    const amount = monthCategoryExpense[cat], pct = monthOut > 0 ? Math.round((amount / monthOut) * 100) : 0;
                    budgetContainer.innerHTML += `
                        <div class="mb-3 last:mb-0"><div class="flex justify-between text-sm mb-1"><span class="text-slate-700 font-medium">${cat}</span><span class="text-slate-500">${formatRupiah(amount)} (${pct}%)</span></div>
                        <div class="w-full bg-slate-100 rounded-full h-2"><div class="${colors[idx % colors.length]} h-2 rounded-full" style="width: ${pct}%"></div></div></div>`;
                });
            }

            const dashGoals = document.getElementById('dash-goals-container'); dashGoals.innerHTML = '';
            if (goals.length === 0) dashGoals.innerHTML = '<p class="text-sm text-slate-500 py-2 text-center mt-4">Belum ada goals yang berjalan.</p>';
            else {
                goals.slice(0, 3).forEach(g => {
                    let pct = (Number(g.current) / Number(g.target)) * 100; if(pct>100) pct=100;
                    dashGoals.innerHTML += `
                        <div class="mb-3 last:mb-0 bg-slate-50 rounded-xl p-3 border border-slate-100">
                            <div class="flex justify-between text-sm mb-1"><span class="text-slate-700 font-bold">${g.name}</span><span class="text-slate-500 font-medium">${pct.toFixed(0)}%</span></div>
                            <div class="w-full bg-slate-200 rounded-full h-1.5 mb-1"><div class="bg-indigo-500 h-1.5 rounded-full" style="width: ${pct}%"></div></div>
                        </div>`;
                });
            }
        }

        // --- CASHFLOW & FILTER ---
        function setupYearFilter() {
            const ySelect = document.getElementById('filter-year');
            const years = new Set(transactions.map(tx => new Date(tx.date).getFullYear()));
            years.add(new Date().getFullYear());
            const sortedYears = Array.from(years).sort((a,b) => b - a);
            ySelect.innerHTML = '';
            sortedYears.forEach(y => ySelect.innerHTML += `<option value="${y}" ${y.toString() === currentFilterYear ? 'selected' : ''}>Tahun ${y}</option>`);
            ySelect.addEventListener('change', (e) => { currentFilterYear = e.target.value; renderCashflow(); });
        }
        window.setFilter = (f) => {
            currentTxFilter = f;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.className = btn.dataset.filter === f ? 'filter-btn px-5 py-2 rounded-full text-sm font-medium bg-lime-400 text-slate-900 shadow-sm' : 'filter-btn px-5 py-2 rounded-full text-sm font-medium bg-slate-800 text-slate-300 hover:bg-slate-700 shadow-sm';
            });
            renderCashflow();
        };

        function renderCashflow() {
            const tbody = document.getElementById('cashflow-list'); tbody.innerHTML = '';
            let filteredTx = transactions.filter(tx => new Date(tx.date).getFullYear().toString() === currentFilterYear);
            if (currentTxFilter !== 'semua') {
                filteredTx = filteredTx.filter(tx => {
                    if (currentTxFilter === 'masuk') return tx.type === 'masuk' || tx.type === 'alokasi';
                    if (currentTxFilter === 'keluar') return tx.type === 'keluar';
                    if (currentTxFilter === 'gaji') return tx.category === 'Gaji';
                    if (currentTxFilter === 'makan') return tx.category === 'Makan' || tx.wallet === 'Makan';
                    if (currentTxFilter === 'jajan') return tx.category === 'Jajan' || tx.wallet === 'Jajan';
                    if (currentTxFilter === 'tabungan_anak') return tx.wallet === 'Tabungan Anak' || tx.category === `Tabungan ${settings.childName}`;
                    if (currentTxFilter === 'hutang') return tx.type === 'catat_hutang';
                    if (currentTxFilter === 'bayar_hutang') return tx.type === 'bayar_hutang';
                    return true;
                });
            }

            if(filteredTx.length === 0) return tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-slate-500">Belum ada riwayat transaksi.</td></tr>`;

            filteredTx.forEach(tx => {
                let sign = '', color = '', icon = '';
                if (tx.type === 'masuk' || tx.type === 'catat_hutang') { sign = '+'; color = tx.type === 'catat_hutang' ? 'text-orange-600' : 'text-emerald-600'; icon = tx.type === 'catat_hutang' ? 'hand-coins text-orange-500' : 'trend-up text-emerald-500'; } 
                else if (tx.type === 'alokasi') { sign = ''; color = 'text-indigo-600'; icon = 'arrows-split text-indigo-500'; } 
                else { sign = '-'; color = tx.type === 'bayar_hutang' ? 'text-blue-600' : 'text-slate-900'; icon = tx.type === 'bayar_hutang' ? 'check-circle text-blue-500' : 'trend-down text-rose-500'; }
                
                const badge = tx.type.replace('_', ' ').toUpperCase();
                let walletStr = tx.wallet || 'Tidak Diketahui';
                if (tx.type === 'alokasi' || (tx.type === 'masuk' && tx.allocations)) walletStr = 'Multi-Alokasi Dompet';
                else if (tx.type === 'masuk') walletStr = 'Belum Dialokasikan';

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50 transition-colors group">
                        <td class="px-6 py-4"><div class="flex items-center gap-3"><div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center shrink-0"><i class="ph ph-${icon} text-lg"></i></div><div><p class="text-sm font-semibold text-slate-900">${tx.description}</p><p class="text-xs text-slate-500">${formatDate(tx.date)} &bull; <b>${badge}</b></p></div></div></td>
                        <td class="px-6 py-4"><p class="text-sm font-medium text-slate-900">${walletStr}</p><p class="text-xs text-slate-500">Pihak: ${tx.party || 'Saya'}</p></td>
                        <td class="px-6 py-4 text-right"><span class="inline-flex px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 border border-slate-200">${tx.category || '-'}</span></td>
                        <td class="px-6 py-4 text-right font-bold ${color}">${sign} ${formatRupiah(tx.amount)}</td>
                        <td class="px-6 py-4 text-center"><button onclick="deleteDocHandler('transactions', '${tx.id}')" class="text-rose-400 hover:text-rose-600 p-1.5 hover:bg-rose-50 rounded-lg opacity-0 group-hover:opacity-100 transition-all"><i class="ph ph-trash text-lg"></i></button></td>
                    </tr>`;
            });
        }

        // --- GOALS ---
        function renderGoals() {
            const list = document.getElementById('goals-list'); list.innerHTML = '';
            if (goals.length === 0) list.innerHTML = `<div class="bg-white rounded-2xl p-8 text-center text-slate-500 border border-slate-200 border-dashed"><i class="ph ph-target text-4xl text-slate-300 mb-2"></i><p>Belum ada target keuangan.</p></div>`;
            goals.forEach(g => {
                let pct = (g.current / g.target) * 100; if(pct>100) pct=100;
                list.innerHTML += `
                    <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm group">
                        <div class="flex justify-between items-start mb-4">
                            <div><h3 class="text-lg font-bold text-slate-900">${g.name}</h3><p class="text-sm text-slate-500 mt-1">Terkumpul: <span class="font-semibold text-indigo-600">${formatRupiah(g.current)}</span> dari ${formatRupiah(g.target)}</p></div>
                            <button onclick="deleteDocHandler('goals', '${g.id}')" class="text-slate-400 hover:text-rose-500 p-1.5 hover:bg-rose-50 rounded-lg"><i class="ph ph-trash text-lg"></i></button>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-3 mb-1"><div class="bg-gradient-to-r from-indigo-500 to-violet-500 h-3 rounded-full transition-all" style="width: ${pct}%"></div></div>
                        <div class="text-right text-xs font-semibold text-slate-600">${pct.toFixed(1)}%</div>
                    </div>`;
            });
        }
        document.getElementById('form-goal').addEventListener('submit', (e) => {
            e.preventDefault();
            const g = { id: Date.now().toString(), name: document.getElementById('goal-name').value, target: Number(document.getElementById('goal-target').value), current: Number(document.getElementById('goal-current').value), createdAt: new Date().toISOString() };
            goals.push(g); goals.sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt)); saveData(); updateUI(); e.target.reset();
        });

        // --- SUBMITS & MODALS ---
        document.getElementById('form-transaction').addEventListener('submit', (e) => {
            e.preventDefault();
            const btn = document.getElementById('btn-submit-tx'), type = document.querySelector('input[name="type"]:checked').value;
            let newTx = { id: Date.now().toString(), type, amount: getNumberFromInput(document.getElementById('amount').value), date: document.getElementById('date').value, description: document.getElementById('description').value, party: 'Saya', createdAt: new Date().toISOString() };
            if (type === 'masuk') newTx.category = document.getElementById('category-in').value;
            else { newTx.wallet = document.getElementById('wallet-out').value; newTx.category = document.getElementById('category-out').value; }
            
            btn.disabled = true;
            setTimeout(() => {
                transactions.push(newTx); transactions.sort((a, b) => new Date(b.date) - new Date(a.date)); saveData(); updateUI(); e.target.reset(); document.getElementById('date').valueAsDate = new Date();
                showModal('Sukses', 'Catatan ditambahkan!'); btn.disabled = false;
            }, 200);
        });

        document.getElementById('form-allocation').addEventListener('submit', (e) => {
            e.preventDefault();
            const txId = document.getElementById('alloc-tx-id').value;
            if (!txId) return showModal('Gagal', 'Silakan klik daftar pemasukan terlebih dahulu!');
            let txIndex = transactions.findIndex(t => t.id === txId); if (txIndex === -1) return;
            
            let allocations = {};
            document.querySelectorAll('.alloc-input').forEach(inp => {
                const val = getNumberFromInput(inp.value); if(val > 0) allocations[inp.dataset.wallet] = val;
            });
            transactions[txIndex].allocations = allocations; saveData(); 
            e.target.reset(); document.getElementById('alloc-tx-id').value = ''; document.getElementById('alloc-selected-desc').textContent = 'Pilih salah satu daftar uang masuk di atas untuk mengisi form ini otomatis.';
            updateUI(); showModal('Sukses', 'Dana berhasil dialokasikan!');
        });

        window.deleteDocHandler = (col, docId) => {
            showModal('Hapus', 'Yakin hapus data ini?', true, () => {
                if (col === 'transactions') transactions = transactions.filter(t => t.id !== docId); else goals = goals.filter(g => g.id !== docId);
                saveData(); updateUI();
            });
        };

        window.openCashflowModal = () => {
            document.getElementById('cf-date').valueAsDate = new Date(); updateCategoriesCF();
            const mc = document.getElementById('modal-cashflow'), mcc = document.getElementById('modal-cashflow-content');
            mc.classList.remove('hidden'); mc.classList.add('flex');
            setTimeout(() => { mc.classList.remove('opacity-0'); mcc.classList.remove('scale-95'); }, 10);
        };
        window.closeCashflowModal = () => {
            const mc = document.getElementById('modal-cashflow'), mcc = document.getElementById('modal-cashflow-content');
            mc.classList.add('opacity-0'); mcc.classList.add('scale-95');
            setTimeout(() => { mc.classList.add('hidden'); mc.classList.remove('flex'); }, 300);
        };
        window.updateCategoriesCF = () => {
            const type = document.querySelector('input[name="cf-type"]:checked').value, select = document.getElementById('cf-category');
            const walletContainer = document.getElementById('cf-wallet-container');
            const walletSelect = document.getElementById('cf-wallet');
            const walletLabel = document.getElementById('cf-wallet-label');

            const config = { 
                masuk: ['Gaji', 'Bonus', 'Lainnya'], 
                keluar: settings.expenseCategories, 
                catat_hutang: ['Pinjam Teman', 'Bank', 'Lainnya'], 
                bayar_hutang: ['Bayar Hutang', 'Lainnya'] 
            };
            
            select.innerHTML = ''; 
            config[type].forEach(cat => select.innerHTML += `<option value="${cat}">${cat}</option>`);

            if (type === 'catat_hutang') {
                walletContainer.style.display = 'none';
                walletSelect.required = false;
                walletSelect.value = '';
            } else {
                walletContainer.style.display = 'block';
                walletSelect.required = true;
                walletLabel.textContent = type === 'bayar_hutang' ? 'Dibayar Dari Dompet' : 'Sumber Dompet';
                
                const currentVal = walletSelect.value; 
                walletSelect.innerHTML = ''; 
                getDompetList().forEach(w => walletSelect.innerHTML += `<option value="${w}">${w}</option>`); 
                if(getDompetList().includes(currentVal)) walletSelect.value = currentVal;
            }
        };

        document.getElementById('form-cashflow-tx').addEventListener('submit', (e) => {
            e.preventDefault();
            const type = document.querySelector('input[name="cf-type"]:checked').value;
            let newTx = {
                id: Date.now().toString(), 
                type: type, 
                wallet: type === 'catat_hutang' ? '' : document.getElementById('cf-wallet').value, 
                party: document.getElementById('cf-party').value,
                amount: getNumberFromInput(document.getElementById('cf-amount').value), 
                category: document.getElementById('cf-category').value, 
                date: document.getElementById('cf-date').value, 
                description: document.getElementById('cf-description').value, 
                createdAt: new Date().toISOString()
            };
            transactions.push(newTx); transactions.sort((a,b) => new Date(b.date) - new Date(a.date)); saveData(); updateUI(); e.target.reset(); closeCashflowModal(); showModal('Sukses', 'Transaksi tersimpan.');
        });

        function updateCategoryOptionsUI() {
            const catOut = document.getElementById('category-out');
            if (catOut) { catOut.innerHTML = ''; settings.expenseCategories.forEach(cat => catOut.innerHTML += `<option value="${cat}">${cat}</option>`); }
            
            const walletLists = [document.getElementById('wallet-out'), document.getElementById('cf-wallet')];
            walletLists.forEach(sel => {
                if(sel) { const currentVal = sel.value; sel.innerHTML = ''; getDompetList().exports || getDompetList().forEach(w => sel.innerHTML += `<option value="${w}">${w}</option>`); if(getDompetList().includes(currentVal)) sel.value = currentVal; }
            });
        }
        function updateUI() { setupYearFilter(); renderWalletSettings(); updateCategoryOptionsUI(); renderDashboard(); renderCashflow(); renderGoals(); toggleFormAdd(); }
        
        window.addEventListener('DOMContentLoaded', () => {
            document.getElementById('date').valueAsDate = new Date();
            document.getElementById('set-account-name').value = settings.accountName || '';
            document.getElementById('set-child-name').value = settings.childName || '';
            document.getElementById('set-categories').value = (settings.expenseCategories || []).join(', ');
            updateUI();
        });
    </script>
</body>
</html>
