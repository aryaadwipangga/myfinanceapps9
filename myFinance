                    </button>
                    <button data-target="view-dompet" class="nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-600 hover:bg-slate-50 hover:text-slate-900">
                        <i class="ph ph-wallet text-lg"></i> Alokasi Dompet
