        </header>

        <main class="flex-1 overflow-y-auto custom-scrollbar p-4 lg:p-8">
            <div class="max-w-6xl mx-auto w-full">
                
                <!-- VIEW: DASHBOARD -->
                <div id="view-dashboard" class="view-section active space-y-6">
                    <div>
                        <h1 class="text-2xl font-bold text-slate-900">Dashboard <span id="dash-account-title" class="text-indigo-600"></span></h1>
                        <p class="text-slate-500 text-sm">Ringkasan kondisi keuangan dan alokasi dompet Anda.</p>
                    </div>

                    <!-- Summary Cards Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
                        <div class="bg-gradient-to-br from-indigo-600 to-violet-700 rounded-2xl p-5 text-white shadow-lg shadow-indigo-200">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-sm font-medium text-indigo-100">Saldo Total</span>
                                <i class="ph ph-wallet text-xl opacity-80"></i>
                            </div>
                            <div class="text-2xl font-bold" id="dash-saldo">Rp 0</div>
                        </div>

                        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-xs font-medium text-slate-500">Pemasukan (Bulan Ini)</span>
                                <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0"><i class="ph ph-trend-up"></i></div>
                            </div>
                            <div class="text-lg font-bold text-slate-900" id="dash-month-in">Rp 0</div>
                        </div>

                        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-xs font-medium text-slate-500">Pengeluaran (Bulan Ini)</span>
                                <div class="w-8 h-8 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center shrink-0"><i class="ph ph-trend-down"></i></div>
                            </div>
                            <div class="text-lg font-bold text-slate-900" id="dash-month-out">Rp 0</div>
                        </div>

                        <div class="bg-rose-50 border border-rose-200 rounded-2xl p-5 shadow-sm">
                            <div class="flex items-center justify-between mb-2">
