                <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2 px-2">Pengaturan</p>
                <nav class="space-y-1">
                    <button data-target="view-settings" class="nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-600 hover:bg-slate-50 hover:text-slate-900">
