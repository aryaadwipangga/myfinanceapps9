                <div class="flex items-center gap-3 px-2 mb-3">
                    <img id="user-avatar" src="" alt="Avatar" class="w-9 h-9 rounded-full bg-slate-200 object-cover">
                    <div class="overflow-hidden">
                        <p id="user-name" class="text-xs font-bold text-slate-900 truncate">-</p>
                        <p id="user-email" class="text-[10px] text-slate-400 truncate">-</p>
