                                            <span class="text-slate-400 font-medium">Rp</span>
                                        </div>
                                        <input type="text" id="amount" required 
                                            class="pl-12 w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 focus:ring-2 focus:ring-indigo-500 font-bold text-lg"
                                            placeholder="0" oninput="formatInputWithDot(this)">
                                    </div>
                                </div>

                                <div>
                                    <label for="description" class="block text-sm font-medium text-slate-700 mb-1">Keterangan Transaksi</label>
                                    <input type="text" id="description" required class="w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 focus:ring-2 focus:ring-indigo-500" placeholder="Cth: Gaji Bulan Ini / Belanja Sayur">
                                </div>

                                <div class="pt-2">
                                    <button type="submit" id="btn-submit-tx" class="w-full flex justify-center items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3.5 px-4 rounded-xl transition-all shadow-md shadow-indigo-200">
                                        <i class="ph ph-floppy-disk text-lg"></i> Simpan Catatan
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- VIEW: ALOKASI DOMPET -->
                <div id="view-dompet" class="view-section space-y-6">
                    <div>
                        <h1 class="text-2xl font-bold text-slate-900">Alokasi Dompet</h1>
                        <p class="text-slate-500 text-sm">Bagikan uang masuk Anda ke berbagai dompet sesuai persentase yang sudah diatur.</p>
                    </div>

                    <!-- Dana Belum Dialokasikan (List Gaji/Pemasukan) -->
                    <div class="bg-indigo-600 rounded-2xl p-5 text-white shadow-lg shadow-indigo-200">
                        <div class="flex justify-between items-center mb-4">
                            <div>
                                <span class="text-sm font-medium text-indigo-100 block mb-1">Total Dana Belum Dialokasikan</span>
                                <div class="text-2xl font-bold" id="dash-dompet-unallocated">Rp 0</div>
                            </div>
                            <i class="ph ph-coins text-4xl opacity-80"></i>
                        </div>
                        <div class="border-t border-indigo-500/50 pt-4 mt-2">
                            <p class="text-xs font-semibold text-indigo-100 mb-3 uppercase tracking-wider">Pilih Uang Masuk yang ingin dibagikan:</p>
                            <!-- KOTAK DAFTAR UANG MASUK (LIST GAJI) -->
                            <div id="unallocated-list" class="max-h-64 overflow-y-auto custom-scrollbar pr-2 flex flex-col gap-2">
                                <!-- List di-render via JS -->
                            </div>
                        </div>
                    </div>

                    <!-- Form Alokasi -->
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                        <div class="flex justify-between items-center mb-4 border-b border-slate-100 pb-2">
                            <h2 class="text-lg font-bold text-slate-900">Bagikan Dana ke Dompet</h2>
                            <button type="button" onclick="clearAllAllocations()" class="text-xs bg-rose-50 text-rose-600 border border-rose-200 px-3 py-1.5 rounded-lg font-semibold hover:bg-rose-100 transition-colors flex items-center gap-1">
                                <i class="ph ph-trash"></i> Kosongkan Semua
                            </button>
                        </div>
                        <form id="form-allocation" class="space-y-5">
