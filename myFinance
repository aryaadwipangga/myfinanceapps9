                                <div class="w-8 h-8 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center shrink-0"><i class="ph ph-warning-circle"></i></div>
                            </div>
                            <div class="text-xl font-bold text-slate-900" id="dash-hutang">Rp 0</div>
                        </div>
                    </div>

                    <!-- Saldo Dompet di Dashboard -->
                    <div>
                        <div class="flex justify-between items-center mb-3">
                            <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                                <i class="ph ph-wallet text-indigo-600"></i> Saldo Masing-Masing Dompet
                            </h2>
                            <button onclick="switchView('view-dompet')" class="text-sm text-indigo-600 font-medium hover:underline">Kelola Alokasi</button>
