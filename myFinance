                                            <option value="Jasa Design 2D">Jasa Design 2D</option>
                                            <option value="Jasa Design 3D">Jasa Design 3D</option>
                                            <option value="Uang Anak">Uang Anak</option>
                                            <option value="Lainnya">Lainnya</option>
                                        </select>
                                    </div>

                                    <!-- Sumber Dompet Pengeluaran -->
                                    <div id="add-wallet-out-container" style="display: none;">
                                        <label for="wallet-out" class="block text-sm font-medium text-slate-700 mb-1">Ambil Dari Dompet</label>
                                        <select id="wallet-out" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 focus:ring-2 focus:ring-indigo-500 bg-white">
                                            <!-- Diisi oleh JS -->
                                        </select>
                                    </div>
                                </div>

                                <!-- Kategori Pengeluaran -->
                                <div id="add-category-out-container" style="display: none;">
                                    <label for="category-out" class="block text-sm font-medium text-slate-700 mb-1">Kategori Pengeluaran</label>
                                    <select id="category-out" class="w-full rounded-xl border border-slate-300 px-4 py-3 text-slate-900 focus:ring-2 focus:ring-indigo-500 bg-white">
                                        <!-- Diisi oleh JS -->
                                    </select>
                                </div>

                                <div>
                                    <label for="amount" class="block text-sm font-medium text-slate-700 mb-1">Total Nominal (Rp)</label>
                                    <div class="relative">
