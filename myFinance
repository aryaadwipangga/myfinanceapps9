                                <!-- Bars akan dirender disini -->
                            </div>
                        </div>

                        <!-- Mini Goals View -->
                        <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col">
                            <div class="flex justify-between items-center mb-4">
                                <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                                    <i class="ph ph-target text-indigo-600"></i> Pantauan Goals
                                </h2>
                                <button onclick="switchView('view-goals')" class="text-sm text-indigo-600 font-medium hover:underline">Lihat Semua</button>
                            </div>
                            <div id="dash-goals-container" class="space-y-4 overflow-y-auto custom-scrollbar flex-1"></div>
                        </div>
                    </div>
                </div>

                <!-- VIEW: TAMBAH CATATAN -->
                <div id="view-add" class="view-section">
                    <div class="max-w-2xl mx-auto">
                        <div class="mb-6">
                            <h1 class="text-2xl font-bold text-slate-900">Tambah Catatan</h1>
                            <p class="text-slate-500 text-sm">Catat uang masuk harian atau catat pengeluaran harian Anda.</p>
                        </div>
                        
                        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
                            <form id="form-transaction" class="space-y-5">
                                <!-- Tipe Transaksi -->
                                <div>
                                    <label class="block text-sm font-medium text-slate-700 mb-2">Jenis Catatan</label>
                                    <div class="grid grid-cols-2 gap-3">
                                        <label class="cursor-pointer">
                                            <input type="radio" name="type" value="masuk" class="peer sr-only" checked onchange="toggleFormAdd()">
                                            <div class="p-2.5 text-center rounded-xl border border-slate-200 peer-checked:border-emerald-500 peer-checked:bg-emerald-50 peer-checked:text-emerald-700 hover:bg-slate-50 transition-colors font-medium text-sm flex flex-col items-center gap-1">
                                                <i class="ph ph-arrow-circle-up text-xl"></i> Pemasukan
                                            </div>
                                        </label>
                                        <label class="cursor-pointer">
                                            <input type="radio" name="type" value="keluar" class="peer sr-only" onchange="toggleFormAdd()">
                                            <div class="p-2.5 text-center rounded-xl border border-slate-200 peer-checked:border-rose-500 peer-checked:bg-rose-50 peer-checked:text-rose-700 hover:bg-slate-50 transition-colors font-medium text-sm flex flex-col items-center gap-1">
                                                <i class="ph ph-arrow-circle-down text-xl"></i> Pengeluaran
                                            </div>
                                        </label>
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                    <div>
                                        <label for="date" class="block text-sm font-medium text-slate-700 mb-1">Tanggal</label>
